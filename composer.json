{
    "name": "imjoehaines/flowder",
    "description": "A simple and extensible fixture loader for PHP 7.3+, supporting SQLite and MySQL",
    "keywords": [
        "fixtures",
        "fixture-loading",
        "mysql",
        "sqlite",
        "testing"
    ],
    "homepage": "https://github.com/imjoehaines/flowder",
    "license": "Unlicense",
    "suggest": {
        "imjoehaines/flowdception": "Support for Flowder in Codeception test suites",
        "imjoehaines/flowder-phpunit": "Support for Flowder in PHPUnit test suites"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5.1",
        "phpstan/phpstan": "^2.1",
        "phpspec/prophecy-phpunit": "^2.0",
        "rector/rector": "^2.1",
        "phpcompatibility/php-compatibility": "dev-develop",
        "squizlabs/php_codesniffer": "^3.13",
        "dealerdirect/phpcodesniffer-composer-installer": "^1"
    },
    "scripts": {
        "sniffer:php81": "phpcs -p . --ignore=vendor/* --standard=PHPCompatibility --extensions=php --runtime-set testVersion 8.1",
        "sniffer:php84": "phpcs -p . --ignore=vendor/* --standard=PHPCompatibility --extensions=php --runtime-set testVersion 8.4",
        "sniffer:psr12": "phpcs -p . --ignore=vendor/* --standard=PSR12 --extensions=php --report-full=PSR12Report.txt -v",
        "sniffer:fix-psr12": "./vendor/bin/phpcbf --file-list=.phpcs --standard=PSR12",
        "stan": "./vendor/bin/phpstan analyse --memory-limit=2G --configuration=phpstan.neon",
        "stan:baseline": "./vendor/bin/phpstan analyse --memory-limit=2G --configuration=phpstan.neon --generate-baseline",
        "rector": "./vendor/bin/rector process --dry-run",
        "rector:fix": "./vendor/bin/rector process",
        "test": "phpunit tests/"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
          "Imjoehaines\\Flowder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
          "Imjoehaines\\Flowder\\Test\\": "tests/"
        }
    }
}
